<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetMajor Condition="'$(TargetMajor)' == ''">10</TargetMajor>
    <TargetFramework>net$(TargetMajor).0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Http2Client/**/*.cs" />
    <Compile Remove="downstream/**/*.cs" />
  </ItemGroup>
</Project>
