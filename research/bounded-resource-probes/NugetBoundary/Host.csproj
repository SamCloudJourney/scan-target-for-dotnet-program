<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="$(ControlledPackageId)" Version="1.0.0" />
    <_TrimmerCustomSteps Include="$(TrimmerAuditAssembly)" Condition="'$(TrimmerAuditAssembly)' != ''">
      <Type>Research.SymbolAuditStep</Type>
    </_TrimmerCustomSteps>
  </ItemGroup>
</Project>